# Секрет для подписи cookie доступа. Любая случайная строка: openssl rand -hex 32
ACCESS_SECRET=

# Вебхук CRM: сюда уходит POST с заявкой
CRM_WEBHOOK_URL=https://tranio.ru/lead-management/tilda_to_lead/<hook-slug>/
# form (по умолчанию, как у Tilda-вебхуков) или json
CRM_WEBHOOK_FORMAT=form
# Необязательно: значение заголовка Authorization, если хук закрыт токеном
CRM_WEBHOOK_AUTH=

# Telegram-чат для сверки заявок
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно: id топика в супергруппе с включёнными темами
TELEGRAM_THREAD_ID=

# Метка источника, уходит в CRM и Telegram
LEAD_SOURCE=phuket-unit-benchmark
